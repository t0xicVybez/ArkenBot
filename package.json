{
  "name": "arkenbot-workspace",
  "version": "1.3.0",
  "private": true,
  "description": "Production-ready multi-purpose Discord bot system",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:deps": "pnpm --filter @arkenbot/shared build && pnpm --filter @arkenbot/addon-sdk build",
    "dev": "pnpm build:deps && concurrently \"pnpm --filter @arkenbot/api dev\" \"pnpm --filter @arkenbot/bot dev\" \"pnpm --filter @arkenbot/web dev\"",
    "build": "pnpm --filter @arkenbot/shared build && pnpm --filter @arkenbot/addon-sdk build && pnpm --filter tickets build && pnpm --filter ai build && pnpm --filter @arkenbot/api build && pnpm --filter @arkenbot/bot build && pnpm --filter @arkenbot/web build",
    "start": "concurrently \"pnpm --filter @arkenbot/api start\" \"pnpm --filter @arkenbot/bot start\" \"pnpm --filter @arkenbot/web start\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:commands": "pnpm db:generate && pnpm --filter @arkenbot/bot deploy:commands",
    "grant-staff": "tsx scripts/grant-staff.ts",
    "docs:dev": "pnpm --filter @arkenbot/docs dev",
    "docs:build": "pnpm --filter @arkenbot/docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@prisma/client": "7.10.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "gray-matter>js-yaml": "3.15.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "http-cache-semantics": "^4.3.0",
      "ws": "^8.22.0",
      "undici": "^6.28.1",
      "joi": "^17.13.7",
      "fast-uri": "^3.1.6",
      "qs": "^6.16.0",
      "mysql2": "^3.22.0",
      "find-my-way": "^9.7.0",
      "socket.io-parser": "^4.2.7",
      "sharp": "^0.35.5",
      "shell-quote": "^1.12.0",
      "esbuild": "0.28.1",
      "fast-jwt": ">=6.3.4",
      "sockjs>uuid": "^11.1.1",
      "next-auth>uuid": "^11.1.1",
      "next>postcss": "^8.5.17",
      "serialize-javascript": "^7.0.7",
      "proxy-addr": "^2.0.8",
      "compression": "^1.8.2",
      "source-map-js": "^1.2.2",
      "fast-copy": "^4.1.0",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "follow-redirects@>=1.16.0 <1.16.1": "1.16.1",
      "vite@>=8.2.0 <=8.2.3": "8.2.4",
      "tinypool@<2.1.2": "2.1.2"
    }
  }
}
