# ============================================================
# Arken Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ============================================================
# Discord (Required)
# Discord Developer Portal → https://discord.com/developers/applications
# ============================================================
DISCORD_TOKEN=                        # Bot token (Bot → Token)
DISCORD_CLIENT_ID=                    # Application ID (OAuth2 → Client ID)
DISCORD_CLIENT_SECRET=                # OAuth2 secret (OAuth2 → Client Secret)
DISCORD_GUILD_ID=                     # Optional: dev guild for instant slash command deploy

# ============================================================
# Database (Required)
# ============================================================
DATABASE_URL=postgresql://arkenbot:secret@localhost:5432/arkenbot

# ============================================================
# Redis (Required)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                       # Leave blank if Redis has no password

# ============================================================
# API Server (Required)
# ============================================================
API_PORT=4000
API_HOST=0.0.0.0
API_SECRET=                           # Random 32+ char string. Generate with: openssl rand -hex 32
                                       # Signs session cookies; also the fallback encryption key for
                                       # stored secrets (OAuth tokens, addon RCON credentials) if
                                       # SESSION_ENCRYPTION_KEY below isn't set.
SESSION_ENCRYPTION_KEY=               # Recommended: a separate random 32+ char string dedicated to
                                       # encrypting stored secrets at rest, so rotating it doesn't also
                                       # invalidate every signed session cookie.
ADDON_ENCRYPTION_KEY=                 # Random 32+ char string — encrypts RCON/server credentials saved
                                       # by the gameservers/gameadmin addons. Falls back to API_SECRET if unset.

# ============================================================
# Web Portal — Build-time variables (Required)
# IMPORTANT: NEXT_PUBLIC_* vars are baked into the Next.js bundle at BUILD time.
# For a remote server, set these to your server's public IP or domain
# so the browser can reach the API. Example:
#   NEXT_PUBLIC_API_URL=http://123.45.67.89:4000
#   NEXT_PUBLIC_WS_URL=ws://123.45.67.89:4000
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_DISCORD_CLIENT_ID=        # Same value as DISCORD_CLIENT_ID

# Server-side API URL used by Next.js during SSR/ISR requests (not exposed to the browser).
# On the same machine this should match API_PORT above. In Docker or behind a reverse proxy,
# point this at the internal service address (e.g. http://api:4000).
API_INTERNAL_URL=http://localhost:4000

# ============================================================
# OAuth2 & CORS (Required)
# DISCORD_REDIRECT_URI must match exactly what is set in
# Discord Developer Portal → OAuth2 → Redirects. The callback route lives on
# the API (packages/api/src/routes/auth.ts), NOT the web dashboard — point
# this at the API's own origin/port, not the dashboard's.
# ============================================================
DISCORD_REDIRECT_URI=http://localhost:4000/auth/callback
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Bot Config (Required)
# ============================================================
BOT_OWNER_IDS=                        # Your Discord user ID (comma-separated, no spaces)
WEB_URL=http://localhost:3000         # Public URL of the web portal (used for leaderboard links)

# URL the bot uses to reach the API internally (not the public browser-facing URL)
API_URL=http://localhost:4000

# ============================================================
# Music (Optional)
# Playback is via yt-dlp (bundled, no separate server required — there is no
# Lavalink dependency). Both variables below are optional fallbacks for hosts
# whose outbound IP gets throttled/blocked by YouTube.
# ============================================================
# SOCKS proxy yt-dlp routes through if direct requests start failing (e.g. a
# residential SOCKS5 tunnel). Format: socks5://host:port
# YTDLP_PROXY=

# Path to a YouTube cookies file (Netscape format) to bypass bot-detection on server IPs.
# Export from browser using the "Get cookies.txt LOCALLY" Chrome extension on youtube.com.
# YOUTUBE_COOKIES_FILE=/home/user/youtube-cookies.txt

# ============================================================
# Stream Alerts (Optional)
# Required only if you want Twitch or YouTube live alerts.
# ============================================================

# Twitch — https://dev.twitch.tv/console/apps → Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitter/X — https://developer.twitter.com → Projects & Apps → Keys and Tokens
# Bearer Token (read-only access) is sufficient for live-stream alerts.
TWITTER_BEARER_TOKEN=

# Riot Games / VALORANT (RSO) — https://developer.riotgames.com
# Requires an APPROVED Production key + an RSO client. Leave blank until granted;
# the Valorant feature stays dormant (every route/command 503s) while unset.
# RIOT_RSO_REDIRECT must exactly match the redirect URI registered on the RSO client.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_API_KEY=
RIOT_RSO_REDIRECT=https://api.arkenbot.app/valorant/rso/callback

# ---- LibreTranslate (self-hosted on this box, under the translatebot user)
# Powers the /translate addon AND the i18n pipeline (scripts/i18n-translate.mjs).
LIBRETRANSLATE_URL=http://localhost:5000
# Only needed if your instance requires API keys (e.g. libretranslate.com)
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_CONCURRENCY=4
LIBRETRANSLATE_TIMEOUT_MS=20000
TRANSLATION_CACHE_SIZE=5000

# YouTube Data API v3 — https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=

# ============================================================
# Groq AI (Optional)
# Free tier available (no credit card): https://console.groq.com
# Powers: the `ai` addon (/ask, /summarize), the Code Review addon's LLM pass
# (falls back to static analysis only if unset), and the tickets addon's AI
# triage. Without it, each of those degrades gracefully rather than failing.
# ============================================================
# GROQ_API_KEY=gsk_...
# GROQ_API_KEY_2=gsk_...               # Optional second key some scripts rotate through on rate limits

# ============================================================
# Logging & Environment
# ============================================================
NODE_ENV=production                   # development | production
LOG_LEVEL=info                        # debug | info | warn | error
TOPGG_TOKEN=            # top.gg API token — posts server count to the bot listing every 30 min
