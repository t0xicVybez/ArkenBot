  enabled          Boolean  @default(false)
  currencyName     String   @default("Coins")
  currencySymbol   String   @default("🪙")
  startingBalance  Int      @default(0)
  dailyAmount      Int      @default(200)
  dailyStreakBonus Int      @default(50) // added per consecutive day, capped at 7x
  workMin          Int      @default(50)
  workMax          Int      @default(300)
  workCooldown     Int      @default(3600) // seconds between /work
  robEnabled       Boolean  @default(true)
  robCooldown      Int      @default(86400) // seconds between /rob attempts
  robSuccessRate   Int      @default(40) // percent chance a rob succeeds
  robMaxPercent    Int      @default(20) // max % of victim wallet stolen on success
  robMinBalance    Int      @default(500) // victim must hold at least this to be robbable
  robFinePercent   Int      @default(15) // % of robber wallet lost as a fine on failure
  gamblingEnabled  Boolean  @default(true)
  maxBet           Int      @default(10000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("economy_config")
}

model EconomyBalance {
