generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Guild (Discord Server)
// ─────────────────────────────────────────────
model Guild {
  id       String    @id // Discord guild ID
  name     String
  iconUrl  String?
  ownerId  String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isActive Boolean   @default(true)

  settings               GuildSettings?
  moderationCases        ModerationCase[]
  userLevels             UserLevel[]
  warnings               Warning[]
  reactionRoles          ReactionRole[]
  reactionRolePanels     ReactionRolePanel[]
  customCommands         CustomCommand[]
  addonData              AddonData[]
  guildAddons            GuildAddon[]
  logEntries             LogEntry[]
  automodConfig          AutoModConfig?
  modmailConfig          ModmailConfig?
  modmailThreads         ModmailThread[]
  economyConfig          EconomyConfig?
  economyBalances        EconomyBalance[]
  economyShopItems       EconomyShopItem[]
  welcomeConfig          WelcomeConfig?
  musicQueue             MusicQueue?
  disabledCommands       DisabledCommand[]
  commandRolePermissions CommandRolePermission[]
  statsChannels          StatsChannel[]
  birthdays              Birthday[]
  birthdayConfig         BirthdayConfig?
  polls                  Poll[]
  scheduledMessages      ScheduledMessage[]
  slowmodeConfigs        SlowmodeConfig[]
  messageActivity        MessageActivity[]
  starboardConfig        StarboardConfig?
  suggestionConfig       SuggestionConfig?
  levelRoles             LevelRole[]
  giveaways              Giveaway[]
  streamAlerts           StreamAlert[]
  tempBans               TempBan[]
  tempRoles              TempRole[]
  topggConfig            TopggConfig?
  reminders              Reminder[]
  countingState          CountingState?
  inviteCounts           InviteCount[]
  inviteJoins            InviteJoin[]
  guildEmbeds            GuildEmbed[]
  autoResponses          AutoResponse[]
  selfRoles              SelfRole[]
  xpRoleMultipliers      XpRoleMultiplier[]
  tempVoiceChannels      TempVoiceChannel[]
  tempVoiceTriggers      TempVoiceTrigger[]
  xpChannelMultipliers   XpChannelMultiplier[]
  userNotes              UserNote[]
  reports                Report[]
  mondayAlerts           MondayAlert[]
  trelloAlerts           TrelloAlert[]
  dashboardAuditLogs     DashboardAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guilds")
}

// ─────────────────────────────────────────────
// Guild Settings (one-to-one with Guild)
// ─────────────────────────────────────────────
model GuildSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Prefix & locale
  prefix   String @default("!")
  locale   String @default("en-US")
  timezone String @default("UTC")

  // Feature toggles
  moderationEnabled    Boolean @default(false)
  autoModEnabled       Boolean @default(false)
  levelingEnabled      Boolean @default(false)
  welcomeEnabled       Boolean @default(false)
  loggingEnabled       Boolean @default(false)
  musicEnabled         Boolean @default(false)
  reactionRolesEnabled Boolean @default(false)

  // Channel IDs
  logChannelId          String?
  modLogChannelId       String?
  welcomeChannelId      String?
  leaveChannelId        String?
  levelUpChannelId      String?
  announcementChannelId String?
  analyticsChannelId    String?

  // Announcement opt-in
  announcementsEnabled Boolean @default(true)

  // Role IDs
  muteRoleId   String?
  autoRoleId   String?
  memberRoleId String?

  // Permission-failure alerts: ping a role when the bot is blocked by missing perms
  permissionAlertsEnabled Boolean @default(true)
  permissionAlertRoleId   String?

  // Leveling config
  xpPerMessage      Int     @default(15)
  xpCooldown        Int     @default(60)
  xpMultiplier      Float   @default(1.0)
  keepPreviousRoles Boolean @default(false)
  levelUpMessage    String  @default("Congratulations {user}, you reached level {level}!")
  levelUpEmbed      Boolean @default(true)
  xpDecayEnabled    Boolean @default(false)
  xpDecayDays       Int     @default(30)
  xpDecayPercent    Int     @default(5)

  // Embed accent colors (per-guild customisation)
  accentColor           String @default("#5865F2")
  musicColor            String @default("#5865F2")
  levelUpColor          String @default("#5865F2")
  giveawayColor         String @default("#F1C40F")
  birthdayColor         String @default("#FFC0CB")
  starboardColor        String @default("#F1C40F")
  moderationColor       String @default("#EB459E")
  reactionRolesColor    String @default("#5865F2")
  streamAlertColor      String @default("#5865F2")
  scheduledMessageColor String @default("#5865F2")
  loggingColor          String @default("")
  announcementColor     String @default("#5865F2")

  // Raw JSON for extended settings
  extended Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_settings")
}

// ─────────────────────────────────────────────
// Auto-Mod Configuration
// ─────────────────────────────────────────────
model AutoModConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Spam protection
  antiSpamEnabled   Boolean @default(false)
  antiSpamThreshold Int     @default(5)
  antiSpamInterval  Int     @default(5000)
  antiSpamAction    String  @default("delete")

  // Word filter
  filterEnabled           Boolean  @default(false)
  filteredWords           String[] @default([])
  filterAction            String   @default("delete")
  filterWarnBeforeTimeout Int      @default(3) // violations before timeout
  filterTimeoutDuration   Int      @default(300) // timeout duration in seconds
  filterWarnBeforeKick    Int      @default(5) // violations before kick
  filterWarnMessage       String   @default("⚠️ {user} Your message was removed for containing a filtered word (violation #{count}).")
  filterKickMessage       String   @default("⛔ {user} was **kicked** for repeated word filter violations (violation #{count}).")
  filterKickDMMessage     String   @default("You were kicked from **{server}** for repeated word filter violations (violation #{count}).")

  // Link filter
  antiLinkEnabled Boolean  @default(false)
  allowedDomains  String[] @default([])
  linkAction      String   @default("delete")

  // Mention spam
  antiMentionEnabled Boolean @default(false)
  mentionThreshold   Int     @default(5)

  // Caps filter
  antiCapsEnabled Boolean @default(false)
  capsThreshold   Int     @default(70)

  // Anti-raid
  antiRaidEnabled Boolean @default(false)
  raidThreshold   Int     @default(10)
  raidInterval    Int     @default(10000)
  raidAction      String  @default("lockdown")

  // Account-age gate & new-account flagging (alt / raid protection)
  minAccountAgeEnabled  Boolean @default(false)
  minAccountAgeHours    Int     @default(72)
  minAccountAgeAction   String  @default("kick") // kick | ban | alert
  newAccountFlagEnabled Boolean @default(false)
  newAccountFlagHours   Int     @default(168)

  // Anti-phishing
  antiPhishingEnabled Boolean @default(false)
  antiPhishingAction  String  @default("delete_mute") // delete | delete_mute

  // AI moderation — context-aware detection of harassment, hate, threats, scams
  aiModEnabled Boolean @default(false)
  aiModAction  String  @default("flag") // flag (alert only) | delete

  // Exempt roles/channels
  exemptRoles    String[] @default([])
  exemptChannels String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automod_configs")
}

// ─────────────────────────────────────────────
// Welcome / Leave Config
// ─────────────────────────────────────────────
model WelcomeConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("Welcome {user} to **{server}**! You are member #{memberCount}.")
  welcomeEmbed     Boolean @default(true)
  welcomeColor     String  @default("#5865F2")
  welcomeDMEnabled Boolean @default(false)
  welcomeDMMessage String  @default("Welcome to {server}!")

  leaveEnabled   Boolean @default(false)
  leaveChannelId String?
  leaveMessage   String  @default("{user} has left the server. We now have {memberCount} members.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("welcome_configs")
}

// ─────────────────────────────────────────────
// Moderation Cases
// ─────────────────────────────────────────────
model ModerationCase {
  id         String @id @default(cuid())
  caseNumber Int
  guildId    String
  guild      Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  type         String // ban, kick, mute, warn, unban, unmute
  userId       String
  userTag      String
  moderatorId  String
  moderatorTag String
  reason       String    @default("No reason provided")
  duration     Int? // seconds for mute/tempban
  expiresAt    DateTime?
  active       Boolean   @default(true)
  messageUrl   String?
  messageId    String?
  channelId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, caseNumber])
  @@index([guildId, userId])
  @@map("moderation_cases")
}

// ─────────────────────────────────────────────
// Warnings
// ─────────────────────────────────────────────
model Warning {
  id           String  @id @default(cuid())
  guildId      String
  guild        Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId       String
  userTag      String  @default("")
  moderatorId  String
  moderatorTag String  @default("")
  reason       String
  active       Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@map("warnings")
}

// ─────────────────────────────────────────────
// User Levels / XP
// ─────────────────────────────────────────────
model UserLevel {
  id             String    @id @default(cuid())
  guildId        String
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId         String
  userTag        String
  xp             Int       @default(0)
  level          Int       @default(0)
  totalMessages  Int       @default(0)
  streakDays     Int       @default(0)
  lastStreakDate DateTime?

  levelUpMessageId String?
  levelUpChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)])
  @@map("user_levels")
}

// ─────────────────────────────────────────────
// Reaction Role Panels
// ─────────────────────────────────────────────
model ReactionRolePanel {
  id          String         @id @default(cuid())
  guildId     String
  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String
  messageId   String? // set by the bot after it creates the Discord message
  title       String         @default("🎭 Self-Roles")
  description String         @default("React below to assign yourself a role.")
  roles       ReactionRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("reaction_role_panels")
}

// ─────────────────────────────────────────────
// Reaction Roles
// ─────────────────────────────────────────────
model ReactionRole {
  id        String @id @default(cuid())
  guildId   String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  messageId String // for panel roles: initially panel.id as placeholder, updated to Discord msg ID by bot
  emoji     String
  roleId    String
  type      String @default("toggle") // toggle, add, remove

  panelId String?
  panel   ReactionRolePanel? @relation(fields: [panelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, emoji])
  @@index([guildId])
  @@map("reaction_roles")
}

// ─────────────────────────────────────────────
// Custom Commands
// ─────────────────────────────────────────────
model CustomCommand {
  id             String   @id @default(cuid())
  guildId        String
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name           String
  aliases        String[] @default([])
  response       String
  embed          Boolean  @default(false)
  embedTitle     String?
  embedColor     String? // hex e.g. #5865F2
  deleteInvoking Boolean  @default(false)
  dmResponse     Boolean  @default(false)
  cooldown       Int      @default(0) // seconds, 0 = no cooldown
  requiredRoles  String[] @default([]) // role IDs — empty = everyone
  enabled        Boolean  @default(true)
  uses           Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("custom_commands")
}

// ─────────────────────────────────────────────
// Music Queue (persisted for resuming)
// ─────────────────────────────────────────────
model MusicQueue {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  tracks  Json   @default("[]")
  volume  Int    @default(100)
  loop    String @default("none") // none, track, queue

  nowPlayingMessageId String?
  nowPlayingChannelId String?

  updatedAt DateTime @updatedAt

  @@map("music_queues")
}

// ─────────────────────────────────────────────
// Log Entries
// ─────────────────────────────────────────────
model LogEntry {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type      String
  userId    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, type])
  @@map("log_entries")
}

// ─────────────────────────────────────────────
// Portal Users (OAuth sessions)
// ─────────────────────────────────────────────
model PortalUser {
  id            String    @id // Discord user ID
  username      String
  discriminator String    @default("0")
  avatar        String?
  email         String?
  accessToken   String?
  refreshToken  String?
  tokenExpires  DateTime?
  isStaff       Boolean   @default(false)
  isBotOwner    Boolean   @default(false)

  sessions UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portal_users")
}

// ─────────────────────────────────────────────
// User Preferences (per-Discord-user, shared by bot + dashboard)
// ─────────────────────────────────────────────
// Language preference keyed by Discord user ID. Written by the dashboard's
// language switcher and the bot's /language command, read by both. `language`
// is null when the user hasn't chosen one — callers then fall back to
// auto-detection (Discord client locale / browser Accept-Language) -> guild
// locale -> default. Kept separate from PortalUser so bot-only users (who never
// logged into the dashboard) can still set a preference.
model UserPreferences {
  userId    String   @id // Discord user ID
  language  String? // BCP-47 locale code, or null = auto-detect
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ─────────────────────────────────────────────
// User Sessions (opaque server-side sessions)
// ─────────────────────────────────────────────
// The dashboard stores no token in the browser — the httpOnly cookie holds an
// opaque session id whose SHA-256 hash is kept here. `previousHash` retains the
// pre-rotation hash for a short grace window so a replayed (rotated-away) token
// can be detected as theft and the whole `familyId` revoked.
model UserSession {
  id           String     @id @default(cuid())
  userId       String
  user         PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  previousHash String?    @unique
  familyId     String
  expiresAt    DateTime
  rotatedAt    DateTime   @default(now())
  revokedAt    DateTime?
  lastUsedAt   DateTime   @default(now())
  userAgent    String?
  ipAddress    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

// ─────────────────────────────────────────────
// Addons Registry
// ─────────────────────────────────────────────
model Addon {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  version     String
  description String
  author      String
  homepage    String?
  enabled     Boolean  @default(true)
  verified    Boolean  @default(false)
  manifest    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guildAddons GuildAddon[]
  addonData   AddonData[]

  @@map("addons")
}

// ─────────────────────────────────────────────
// Guild <> Addon (per-guild addon settings)
// ─────────────────────────────────────────────
model GuildAddon {
  id       String  @id @default(cuid())
  guildId  String
  guild    Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  addonId  String
  addon    Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  enabled  Boolean @default(true)
  settings Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, addonId])
  @@map("guild_addons")
}

// ─────────────────────────────────────────────
// Addon Data Store (KV per addon per guild)
// ─────────────────────────────────────────────
model AddonData {
  id      String  @id @default(cuid())
  guildId String?
  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  addonId String
  addon   Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  key     String
  value   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, addonId, key])
  @@index([addonId, key])
  @@map("addon_data")
}

// ─────────────────────────────────────────────
// System Metrics (for staff dashboard)
// ─────────────────────────────────────────────
model SystemMetric {
  id         String   @id @default(cuid())
  metricType String
  value      Float
  metadata   Json     @default("{}")
  recordedAt DateTime @default(now())

  @@index([metricType, recordedAt(sort: Desc)])
  @@map("system_metrics")
}

// ─────────────────────────────────────────────
// Bot Announcements (staff-sent, broadcast to opted-in guilds)
// ─────────────────────────────────────────────
model BotAnnouncement {
  id         String   @id @default(cuid())
  title      String
  body       String
  type       String   @default("update") // update | feature | maintenance | hotfix
  authorId   String
  guildCount Int      @default(0)
  sentAt     DateTime @default(now())

  @@map("bot_announcements")
}

// ─────────────────────────────────────────────
// Per-Guild Disabled Commands
// ─────────────────────────────────────────────
model DisabledCommand {
  id          String @id @default(cuid())
  guildId     String
  guild       Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  commandName String

  @@unique([guildId, commandName])
  @@index([guildId])
  @@map("disabled_commands")
}

// ─────────────────────────────────────────────
// Server Stats Channels
// ─────────────────────────────────────────────
model StatsChannel {
  id        String @id @default(cuid())
  guildId   String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  type      String // members | online | boosts | bots
  format    String @default("{value} Members") // {value} replaced at runtime

  updatedAt DateTime @updatedAt

  @@unique([guildId, channelId])
  @@index([guildId])
  @@map("stats_channels")
}

// ─────────────────────────────────────────────
// Birthday Tracker
// ─────────────────────────────────────────────
model Birthday {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId  String
  month   Int // 1-12
  day     Int // 1-31

  lastNotifiedYear Int? // year the birthday message was last sent — prevents duplicate sends

  notificationMessageId String?
  notificationChannelId String?

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId, month, day])
  @@map("birthdays")
}

model BirthdayConfig {
  id             String  @id @default(cuid())
  guildId        String  @unique
  guild          Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled        Boolean @default(false)
  channelId      String?
  birthdayRoleId String?
  message        String  @default("🎂 Happy Birthday {user}! We hope you have a wonderful day!")

  updatedAt DateTime @updatedAt

  @@map("birthday_configs")
}

// ─────────────────────────────────────────────
// Polls
// ─────────────────────────────────────────────
model Poll {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String
  messageId   String?
  question    String
  options     Json // string[]
  endsAt      DateTime?
  closed      Boolean   @default(false)
  multiVote   Boolean   @default(false)
  createdById String

  votes PollVote[]

  createdAt DateTime @default(now())

  @@index([guildId])
  @@map("polls")
}

model PollVote {
  id          String @id @default(cuid())
  pollId      String
  poll        Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  optionIndex Int

  createdAt DateTime @default(now())

  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
  @@map("poll_votes")
}

// ─────────────────────────────────────────────
// Scheduled Messages
// ─────────────────────────────────────────────
model ScheduledMessage {
  id            String    @id @default(cuid())
  guildId       String
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId     String
  content       String
  embed         Boolean   @default(false)
  scheduledAt   DateTime
  repeat        String? // null | hourly | daily | weekly
  timezone      String? // IANA tz (e.g. Asia/Bangkok); null = UTC
  daysOfWeek    Int[]     @default([]) // for weekly repeat: 0=Sun..6=Sat; empty = every 7 days
  lastSentAt    DateTime?
  enabled       Boolean   @default(true)
  roleMentionId String? // role to ping when message is sent
  failureCount  Int       @default(0) // consecutive delivery failures; auto-disabled at 5
  lastError     String? // most recent delivery failure reason

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([scheduledAt, enabled])
  @@map("scheduled_messages")
}

// ─────────────────────────────────────────────
// Auto-Slowmode Config (per channel)
// ─────────────────────────────────────────────
model SlowmodeConfig {
  id              String  @id @default(cuid())
  guildId         String
  guild           Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId       String
  enabled         Boolean @default(true)
  threshold       Int     @default(10) // messages per window to trigger
  windowSeconds   Int     @default(10) // tracking window in seconds
  slowmodeSeconds Int     @default(5) // slowmode to apply
  resetAfter      Int     @default(30) // seconds of inactivity before removing

  @@unique([guildId, channelId])
  @@index([guildId])
  @@map("slowmode_configs")
}

// ─────────────────────────────────────────────
// Message Activity (daily counts for graphs)
// ─────────────────────────────────────────────
model MessageActivity {
  id      String   @id @default(cuid())
  guildId String
  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  date    DateTime // truncated to start of day UTC
  count   Int      @default(0)

  @@unique([guildId, date])
  @@index([guildId, date(sort: Desc)])
  @@map("message_activity")
}

// ─────────────────────────────────────────────
// Bot Config (singleton — one row, id = "main")
// ─────────────────────────────────────────────
model BotConfig {
  id           String   @id @default("main")
  activityType String   @default("Watching") // Playing | Listening | Watching | Competing | Custom
  activityText String   @default("{servers} servers") // supports {servers}, {users}
  status       String   @default("online") // online | idle | dnd | invisible
  updatedAt    DateTime @updatedAt

  @@map("bot_config")
}

// ─────────────────────────────────────────────
// Temp Bans
// ─────────────────────────────────────────────
model TempBan {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  moderatorId String
  reason      String   @default("No reason provided")
  expiresAt   DateTime
  unbanned    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([guildId, unbanned, expiresAt])
  @@map("temp_bans")
}

// ─────────────────────────────────────────────
// Temp Roles
// ─────────────────────────────────────────────
model TempRole {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  roleId      String
  moderatorId String
  reason      String   @default("No reason provided")
  expiresAt   DateTime
  removed     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([guildId, userId, roleId])
