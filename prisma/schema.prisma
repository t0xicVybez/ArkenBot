// ─────────────────────────────────────────────
// Stream Alerts (Twitch, Kick, RSS, YouTube notifications)
// ─────────────────────────────────────────────
model StreamAlert {
  id                   String   @id @default(cuid())
  guildId              String
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  platform             String // "twitch" | "kick" | "rss" | "youtube"
  channelUsername      String
  channelId            String? // resolved platform ID (e.g. YouTube channel ID)
  discordChannelId     String
  message              String   @default("{streamer} is now live! {url}")
  enabled              Boolean  @default(true)
  lastStreamId         String? // last known stream/video ID to detect new streams
  lastMessageId        String?
  lastMessageChannelId String?
  failureCount         Int      @default(0) // consecutive delivery failures; auto-disabled at 5
  lastError            String? // most recent delivery failure reason
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([guildId, platform, channelUsername])
  @@index([guildId, platform, enabled])
  @@map("stream_alerts")
}

// ─────────────────────────────────────────────
// Auto-Responses (regex-triggered replies)
// ─────────────────────────────────────────────
model AutoResponse {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pattern       String // regex pattern string (no delimiters, flags stored separately)
  flags         String   @default("i") // regex flags, e.g. "i", "gi"
  response      String
  embed         Boolean  @default(false)
  embedColor    String?
  deleteMessage Boolean  @default(false) // delete the triggering message
  enabled       Boolean  @default(true)
  ignoreBots    Boolean  @default(true)
  requiredRoles String[] @default([]) // empty = everyone
  ignoredRoles  String[] @default([]) // roles exempt from triggering
  createdById   String
  uses          Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, enabled])
  @@map("auto_responses")
}

