// ─────────────────────────────────────────────
// Top.gg voting — per-guild reward config + global voter records
// ─────────────────────────────────────────────
model TopggConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // Temporary "voter" role granted on each vote.
  voterRoleId    String?
  voterRoleHours Int     @default(12)

  // XP granted on each vote (0 = off). Doubled on weekends when weekendDouble.
  xpReward      Int     @default(0)
  weekendDouble Boolean @default(true)

  // The top.gg vote link {url} points at — a server listing (top.gg/servers/…)
  // or the bot (top.gg/bot/…). Used by /vote and, when set, by announcements.
  voteUrl String?

  // This server's own top.gg webhook signing secret (whs_…), so server-listing
  // votes verify without the bot owner touching env. Never returned by the API.
  webhookSecret String?

  // Public thank-you announcement.
  announceChannelId String?
  announceMessage   String  @default("🎉 {user} just voted for us on top.gg — thank you! You can vote too: {url}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topgg_configs")
}

model TopggVoter {
  id             String    @id @default(cuid())
  userId         String    @unique
  totalVotes     Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastVotedAt    DateTime?
  // When the 12-hour cooldown ends and the user may vote again.
  eligibleAt     DateTime?
  remindersOptIn Boolean   @default(false)
  reminderSent   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([remindersOptIn, reminderSent, eligibleAt])
  @@index([totalVotes])
  @@map("topgg_voters")
}

