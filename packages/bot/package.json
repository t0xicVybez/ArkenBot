{
  "name": "@arkenbot/bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file ../../.env dist/index.js",
    "start:sharded": "node --env-file ../../.env dist/shard.js",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "tsx --env-file ../../.env src/scripts/deployCommands.ts",
    "cleanup:commands": "tsx --env-file ../../.env src/scripts/cleanupCommands.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@arkenbot/addon-sdk": "workspace:*",
    "@arkenbot/shared": "workspace:*",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^0.1.97",
    "@prisma/client": "^5.22.0",
    "@snazzah/davey": "^0.1.6",
    "axios": "^1.18.0",
    "bullmq": "^5.13.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.4.1",
    "libsodium-wrappers": "^0.7.15",
    "mediaplex": "^0.0.8",
    "ms": "^2.1.3",
    "opusscript": "^0.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "rss-parser": "^3.13.0",
    "sodium-native": "^4.3.2",
    "youtube-sr": "^4.3.11"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0"
  }
}
