{
  "name": "@arkenbot/bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/index.ts",
    "build": "tsc && rm -rf dist/i18n/locales && cp -r src/i18n/locales dist/i18n/locales",
    "start": "node --env-file ../../.env dist/index.js",
    "start:sharded": "node --env-file ../../.env dist/shard.js",
    "typecheck": "tsc --noEmit",
    "deploy:commands": "tsx --env-file ../../.env src/scripts/deployCommands.ts",
    "cleanup:commands": "tsx --env-file ../../.env src/scripts/cleanupCommands.ts",
    "lint": "eslint src -c ../../eslint.config.mjs"
  },
  "dependencies": {
    "@arkenbot/addon-sdk": "workspace:*",
    "@arkenbot/shared": "workspace:*",
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^5.22.0",
    "@snazzah/davey": "^0.1.12",
    "axios": "^1.19.0",
    "bullmq": "^5.81.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "libsodium-wrappers": "^0.7.16",
    "mediaplex": "^0.0.8",
    "ms": "^2.1.3",
    "opusscript": "^0.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "sodium-native": "^4.3.3",
    "youtube-sr": "^4.3.12"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
